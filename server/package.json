{
  "name": "guftugu-server",
  "version": "0.1.0",
  "private": true,
  "description": "Guftugu chat server — portable TypeScript core with cloud adapters (AWS reference)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "sam build",
    "deploy": "sam build && sam deploy",
    "admin": "tsx admin/cli.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1137.0",
    "@aws-sdk/client-dynamodb": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/lib-dynamodb": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
